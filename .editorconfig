root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,css,html,json,md}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.{cs,csproj,ps1,cmd,ahk,ini,manifest}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
